# Unique immutable identifier for a deployed build (usually the Git commit SHA).
DEPLOYMENT_VERSION=development

# Optional. Enables AI-written answers in Ask Paisaan. The guide remains useful without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Used only by the controlled IPO snapshot refresh script. Never exposed to the browser.
IPOALERTS_API_KEY=
# Keep refreshes at least four hours apart and cap one run to five provider calls.
IPO_SNAPSHOT_MIN_AGE_MINUTES=240
IPOALERTS_MAX_REQUESTS=5
