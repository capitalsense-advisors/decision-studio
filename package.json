{
  "name": "capitalsense-decision-studio",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "12.16.1"
  },
  "workspaces": ["apps/web"],
  "devDependencies": {
    "next": "16.4.2"
  },
  "scripts": {
    "dev": "pnpm --filter @capitalsense/decision-studio-web dev",
    "build": "pnpm --filter @capitalsense/decision-studio-web build",
    "start": "pnpm --filter @capitalsense/decision-studio-web start",
    "lint": "pnpm --filter @capitalsense/decision-studio-web lint",
    "test": "pnpm test:web",
    "test:web": "pnpm --filter @capitalsense/decision-studio-web test",
    "refresh:ipos": "node scripts/refresh-ipo-snapshot.mjs",
    "typecheck": "pnpm --filter @capitalsense/decision-studio-web typecheck",
    "release:check": "pnpm lint && pnpm typecheck && pnpm test:web && pnpm build && pnpm smoke:production",
    "smoke:production": "node scripts/smoke-production.mjs"
  }
}
