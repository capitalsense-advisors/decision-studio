{
  "name": "capitalsense-decision-studio",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": ["apps/web"],
  "devDependencies": {
    "next": "16.4.2"
  },
  "scripts": {
    "dev": "npm run dev --workspace @capitalsense/decision-studio-web",
    "build": "npm run build --workspace @capitalsense/decision-studio-web",
    "start": "npm run start --workspace @capitalsense/decision-studio-web",
    "lint": "npm run lint --workspace @capitalsense/decision-studio-web",
    "test": "npm run test:web",
    "test:web": "npm run test --workspace @capitalsense/decision-studio-web",
    "refresh:ipos": "node scripts/refresh-ipo-snapshot.mjs",
    "typecheck": "npm run typecheck --workspace @capitalsense/decision-studio-web",
    "release:check": "npm run lint && npm run typecheck && npm run test:web && npm run build && npm run smoke:production",
    "smoke:production": "node scripts/smoke-production.mjs"
  }
}
